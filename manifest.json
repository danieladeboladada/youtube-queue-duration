{
  "manifest_version": 3,
  "name": "YouTube Queue Duration",
  "version": "0.1.0",
  "description": "Shows the total duration of the videos in the current YouTube Up Next / playlist queue.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"]
}
